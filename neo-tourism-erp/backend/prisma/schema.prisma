model User {
  id                             String                      @id @default(uuid()) @db.Uuid
  email                          String                      @unique
  passwordHash                   String
  firstName                      String
  lastName                       String
  isActive                       Boolean                     @default(true)
  departmentId                   String?                     @db.Uuid
  createdAt                      DateTime                    @default(now())
  updatedAt                      DateTime                    @updatedAt
  department                     Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  roles                          UserRole[]
  assignedLeads                  Lead[]                      @relation("AssignedUserLeads")
  createdLeads                   Lead[]                      @relation("LeadCreatedBy")
  leadActivities                 LeadActivity[]
  createdCustomers               Customer[]                  @relation("CustomerCreatedBy")
  updatedCustomers               Customer[]                  @relation("CustomerUpdatedBy")
  customerNotes                  CustomerNote[]
  auditLogs                      AuditLog[]
  notifications                  Notification[]
  assignedFollowUps              FollowUp[]                  @relation("FollowUpAssignedUser")
  createdFollowUps               FollowUp[]                  @relation("FollowUpCreatedBy")
  completedFollowUps             FollowUp[]                  @relation("FollowUpCompletedBy")
  saleSubmissions                SaleSubmission[]
  salesBookings                  Booking[]                   @relation("BookingSalesAdvisor")
  operationsBookings             Booking[]                   @relation("BookingOperationsOwner")
  createdBookings                Booking[]                   @relation("BookingCreatedBy")
  uploadedDocuments              BookingDocument[]
  bookingNotes                   BookingNote[]
  assignedBookingTasks           BookingTask[]               @relation("BookingTaskAssignedUser")
  createdBookingTasks            BookingTask[]               @relation("BookingTaskCreatedBy")
  recordedPassengerPayments      PassengerPayment[]          @relation("PassengerPaymentRecordedBy")
  verifiedPassengerPayments      PassengerPayment[]          @relation("PassengerPaymentVerifiedBy")
  recordedSupplierPayments       SupplierPayment[]           @relation("SupplierPaymentRecordedBy")
  verifiedSupplierPayments       SupplierPayment[]           @relation("SupplierPaymentVerifiedBy")
  createdBookingAdjustments      BookingAdjustment[]         @relation("BookingAdjustmentCreatedBy")
  approvedBookingAdjustments     BookingAdjustment[]         @relation("BookingAdjustmentApprovedBy")
  completedReconciliations       Reconciliation[]            @relation("ReconciliationCompletedBy")
  assignedDiscrepancies          ReconciliationDiscrepancy[] @relation("DiscrepancyAssignedUser")
  createdDiscrepancies           ReconciliationDiscrepancy[] @relation("DiscrepancyCreatedBy")
  resolvedDiscrepancies          ReconciliationDiscrepancy[] @relation("DiscrepancyResolvedBy")
  createdCustomerInvoices        CustomerInvoice[]           @relation("CustomerInvoiceCreatedBy")
  createdSupplierInvoices        SupplierInvoice[]           @relation("SupplierInvoiceCreatedBy")
  recordedCustomerAdvances       CustomerAdvance[]           @relation("CustomerAdvanceRecordedBy")
  allocatedCustomerAdvances      CustomerAdvanceAllocation[] @relation("CustomerAdvanceAllocatedBy")
  reversedCustomerAdvances       CustomerAdvanceAllocation[] @relation("CustomerAdvanceReversedBy")
  recordedSupplierAdvances       SupplierAdvance[]           @relation("SupplierAdvanceRecordedBy")
  allocatedSupplierAdvances      SupplierAdvanceAllocation[] @relation("SupplierAdvanceAllocatedBy")
  reversedSupplierAdvances       SupplierAdvanceAllocation[] @relation("SupplierAdvanceReversedBy")
  createdBankAccounts            CompanyBankAccount[]        @relation("BankAccountCreatedBy")
  updatedBankAccounts            CompanyBankAccount[]        @relation("BankAccountUpdatedBy")
  createdBankTransactions        BankTransaction[]           @relation("BankTransactionCreatedBy")
  createdBankStatements          BankStatement[]             @relation("BankStatementCreatedBy")
  finalizedBankStatements        BankStatement[]             @relation("BankStatementFinalizedBy")
  reopenedBankStatements         BankStatement[]             @relation("BankStatementReopenedBy")
  matchedBankTransactions        BankReconciliationMatch[]   @relation("BankMatchMatchedBy")
  unmatchedBankTransactions      BankReconciliationMatch[]   @relation("BankMatchUnmatchedBy")
  createdGlAccounts              GlAccount[]                 @relation("GlAccountCreatedBy")
  updatedGlAccounts              GlAccount[]                 @relation("GlAccountUpdatedBy")
  changedAccountingMappings      AccountingMapping[]         @relation("AccountingMappingUpdatedBy")
  createdJournalEntries          JournalEntry[]              @relation("JournalCreatedBy")
  approvedJournalEntries         JournalEntry[]              @relation("JournalApprovedBy")
  postedJournalEntries           JournalEntry[]              @relation("JournalPostedBy")
  reversedJournalEntries         JournalEntry[]              @relation("JournalReversedBy")
  updatedAccountingSettings      AccountingSetting[]         @relation("AccountingSettingUpdatedBy")
  createdExchangeRates           ExchangeRate[]              @relation("ExchangeRateCreatedBy")
  updatedExchangeRates           ExchangeRate[]              @relation("ExchangeRateUpdatedBy")
  createdTaxCodes                TaxCode[]                   @relation("TaxCodeCreatedBy")
  updatedTaxCodes                TaxCode[]                   @relation("TaxCodeUpdatedBy")
  createdAccountingPeriods       AccountingPeriod[]          @relation("AccountingPeriodCreatedBy")
  closedAccountingPeriods        AccountingPeriod[]          @relation("AccountingPeriodClosedBy")
  reopenedAccountingPeriods      AccountingPeriod[]          @relation("AccountingPeriodReopenedBy")
  reopenedBookings               Booking[]                   @relation("BookingReopenedBy")
  employee                       Employee?                   @relation("EmployeeUser")
  reviewedLeaveRequests          LeaveRequest[]              @relation("LeaveReviewedBy")
  leaveApprovals                 LeaveApproval[]             @relation("LeaveApprovalApprover")
  uploadedEmployeeDocuments      EmployeeDocument[]          @relation("EmployeeDocumentUploadedBy")
  assignedAssets                 AssetAssignment[]           @relation("AssetAssignedBy")
  returnedAssets                 AssetAssignment[]           @relation("AssetReturnedTo")
  assignedITTickets              ITTicket[]                  @relation("ITTicketAssignedTo")
  itTicketActivities             ITTicketActivity[]
  createdAccessRequests          AccessRequest[]             @relation("AccessRequestRequestedBy")
  reviewedAccessRequests         AccessRequest[]             @relation("AccessRequestReviewedBy")
  callLogs                       CallLog[]
  createdMarketingDeals          MarketingDeal[]             @relation("MarketingDealCreatedBy")
  updatedMarketingDeals          MarketingDeal[]             @relation("MarketingDealUpdatedBy")
  approvedMarketingDeals         MarketingDeal[]             @relation("MarketingDealApprovedBy")
  suspendedMarketingDeals        MarketingDeal[]             @relation("MarketingDealSuspendedBy")
  ownedMarketingCampaigns        MarketingCampaign[]         @relation("MarketingCampaignOwner")
  createdMarketingCampaigns      MarketingCampaign[]         @relation("MarketingCampaignCreatedBy")
  updatedMarketingCampaigns      MarketingCampaign[]         @relation("MarketingCampaignUpdatedBy")
  assignedMarketingContent       MarketingContent[]          @relation("MarketingContentAssignedTo")
  createdMarketingContent        MarketingContent[]          @relation("MarketingContentCreatedBy")
  updatedMarketingContent        MarketingContent[]          @relation("MarketingContentUpdatedBy")
  marketingContentVersions       MarketingContentVersion[]
  requestedContentApprovals      MarketingContentApproval[]  @relation("ContentApprovalRequestedBy")
  reviewedContentApprovals       MarketingContentApproval[]  @relation("ContentApprovalReviewer")
  marketingContentComments       MarketingContentComment[]
  assignedCalendarEntries        MarketingCalendarEntry[]    @relation("MarketingCalendarAssignedTo")
  createdCalendarEntries         MarketingCalendarEntry[]    @relation("MarketingCalendarCreatedBy")
  updatedCalendarEntries         MarketingCalendarEntry[]    @relation("MarketingCalendarUpdatedBy")
  createdMarketingSalesSignals   MarketingSalesSignal[]
  createdMarketingAttributions   MarketingAttribution[]      @relation("MarketingAttributionCreatedBy")
  createdMarketingOpportunities  MarketingOpportunity[]      @relation("MarketingOpportunityCreatedBy")
  assignedMarketingOpportunities MarketingOpportunity[]      @relation("MarketingOpportunityAssignedTo")
  createdNeoTrioCharacters       NeoTrioCharacter[]          @relation("NeoTrioCharacterCreatedBy")
  updatedNeoTrioCharacters       NeoTrioCharacter[]          @relation("NeoTrioCharacterUpdatedBy")
  uploadedNeoTrioCharacterAssets NeoTrioCharacterAsset[]     @relation("NeoTrioCharacterAssetUploadedBy")
  approvedNeoTrioCharacterAssets NeoTrioCharacterAsset[]     @relation("NeoTrioCharacterAssetApprovedBy")
  submittedNeoTrioIdeas          NeoTrioIdea[]               @relation("NeoTrioIdeaSubmittedBy")
  assignedNeoTrioIdeas           NeoTrioIdea[]               @relation("NeoTrioIdeaAssignedTo")
  createdNeoTrioProductions      NeoTrioProduction[]         @relation("NeoTrioProductionCreatedBy")
  updatedNeoTrioProductions      NeoTrioProduction[]         @relation("NeoTrioProductionUpdatedBy")
  assignedNeoTrioProductions     NeoTrioProduction[]         @relation("NeoTrioProductionAssignedTo")
  createdNeoTrioScripts          NeoTrioScript[]
  createdNeoTrioProductionAssets NeoTrioProductionAsset[]
  createdNeoTrioSeries           NeoTrioSeries[]

  @@index([departmentId])
}

model Department {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  employees   Employee[]
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
