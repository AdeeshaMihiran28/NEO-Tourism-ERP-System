  campaign          MarketingCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  content           MarketingContent?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  deal              MarketingDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  neoTrioIdea       NeoTrioIdea?

  @@index([status, priority, createdAt])
  @@index([destination, status])
  @@index([sourceType, sourceReferenceId])
  @@index([assignedUserId, status])
}

model NeoTrioIdeaCounter {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model NeoTrioProductionCounter {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model NeoTrioSeriesCounter {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model NeoTrioCharacter {
  id                   String                       @id @default(uuid()) @db.Uuid
  code                 String                       @unique
  name                 String
  shortDescription     String?
  personality          String?
  appearanceGuidelines String?
  voiceStyleGuidelines String?
  generalGuidelines    String?
  isActive             Boolean                      @default(true)
  createdById          String                       @db.Uuid
  updatedById          String                       @db.Uuid
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  createdBy            User                         @relation("NeoTrioCharacterCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy            User                         @relation("NeoTrioCharacterUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  assets               NeoTrioCharacterAsset[]
  ideas                NeoTrioIdeaCharacter[]
  productions          NeoTrioProductionCharacter[]

  @@index([isActive, name])
}

model NeoTrioCharacterAsset {
  id              String                    @id @default(uuid()) @db.Uuid
  characterId     String                    @db.Uuid
  versionGroupKey String                    @db.Uuid
  assetType       NeoTrioCharacterAssetType
  title           String
  description     String?
  fileName        String
  storageKey      String
  mimeType        String
  fileSize        Int
  version         Int
  status          NeoTrioAssetStatus        @default(DRAFT)
  isMasterAsset   Boolean                   @default(false)
  uploadedById    String                    @db.Uuid
  approvedById    String?                   @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  character       NeoTrioCharacter          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  uploadedBy      User                      @relation("NeoTrioCharacterAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvedBy      User?                     @relation("NeoTrioCharacterAssetApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([versionGroupKey, version])
  @@index([characterId, status, assetType])
  @@index([characterId, isMasterAsset])
}

model NeoTrioIdea {
  id                     String                 @id @default(uuid()) @db.Uuid
  ideaCode               String                 @unique
  title                  String
  description            String
  ideaType               NeoTrioIdeaType
  destination            String?
  trendReference         String?
  priority               MarketingPriority      @default(NORMAL)
  status                 NeoTrioIdeaStatus      @default(NEW)
  submittedById          String                 @db.Uuid
  assignedUserId         String?                @db.Uuid
  campaignId             String?                @db.Uuid
  dealId                 String?                @db.Uuid
  marketingOpportunityId String?                @unique @db.Uuid
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  submittedBy            User                   @relation("NeoTrioIdeaSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  assignedUser           User?                  @relation("NeoTrioIdeaAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  campaign               MarketingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deal                   MarketingDeal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  marketingOpportunity   MarketingOpportunity?  @relation(fields: [marketingOpportunityId], references: [id], onDelete: SetNull)
  characters             NeoTrioIdeaCharacter[]
  production             NeoTrioProduction?

  @@index([status, priority, createdAt])
  @@index([assignedUserId, status])
  @@index([campaignId])
  @@index([destination])
}

model NeoTrioIdeaCharacter {
  ideaId      String           @db.Uuid
  characterId String           @db.Uuid
  idea        NeoTrioIdea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  character   NeoTrioCharacter @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([ideaId, characterId])
  @@index([characterId, ideaId])
}

model NeoTrioSeries {
  id          String              @id @default(uuid()) @db.Uuid
  seriesCode  String              @unique
  name        String
  description String?
  isActive    Boolean             @default(true)
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Restrict)
  productions NeoTrioProduction[]

  @@index([isActive, name])
}

model NeoTrioProduction {
  id                 String                       @id @default(uuid()) @db.Uuid
  productionCode     String                       @unique
  title              String
  description        String?
  productionType     NeoTrioProductionType
  stage              NeoTrioProductionStage       @default(IDEA)
  ideaId             String?                      @unique @db.Uuid
  campaignId         String?                      @db.Uuid
  dealId             String?                      @db.Uuid
  marketingContentId String?                      @unique @db.Uuid
  seriesId           String?                      @db.Uuid
  assignedUserId     String?                      @db.Uuid
  deadline           DateTime?                    @db.Date
  plannedPublishAt   DateTime?
  priority           MarketingPriority            @default(NORMAL)
  createdById        String                       @db.Uuid
  updatedById        String                       @db.Uuid
  publishedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  idea               NeoTrioIdea?                 @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  campaign           MarketingCampaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deal               MarketingDeal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  marketingContent   MarketingContent?            @relation(fields: [marketingContentId], references: [id], onDelete: SetNull)
  series             NeoTrioSeries?               @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  assignedUser       User?                        @relation("NeoTrioProductionAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy          User                         @relation("NeoTrioProductionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy          User                         @relation("NeoTrioProductionUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  characters         NeoTrioProductionCharacter[]
  scripts            NeoTrioScript[]
  assets             NeoTrioProductionAsset[]
  libraryItem        NeoTrioLibraryItem?

  @@index([stage, priority, createdAt])
  @@index([assignedUserId, stage])
  @@index([deadline])
  @@index([plannedPublishAt])
  @@index([campaignId])
  @@index([dealId])
  @@index([seriesId])
}

model NeoTrioProductionCharacter {
  productionId String            @db.Uuid
  characterId  String            @db.Uuid
  production   NeoTrioProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  character    NeoTrioCharacter  @relation(fields: [characterId], references: [id], onDelete: Restrict)

  @@id([productionId, characterId])
  @@index([characterId, productionId])
}

model NeoTrioScript {
  id            String            @id @default(uuid()) @db.Uuid
  productionId  String            @db.Uuid
  versionNumber Int
  title         String
  scriptText    String
  notes         String?
  createdById   String            @db.Uuid
  createdAt     DateTime          @default(now())
  production    NeoTrioProduction @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([productionId, versionNumber])
  @@index([createdById])
}

model NeoTrioProductionAsset {
  id              String                     @id @default(uuid()) @db.Uuid
  productionId    String                     @db.Uuid
  versionGroupKey String                     @db.Uuid
  assetType       NeoTrioProductionAssetType
  title           String?
  fileName        String
  storageKey      String
  mimeType        String
  fileSize        Int
  version         Int
  createdById     String                     @db.Uuid
  createdAt       DateTime                   @default(now())
  production      NeoTrioProduction          @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdBy       User                       @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([versionGroupKey, version])
  @@index([productionId, assetType])
}

model NeoTrioLibraryItem {
  id                 String                @id @default(uuid()) @db.Uuid
  productionId       String                @unique @db.Uuid
  marketingContentId String?               @db.Uuid
  publicationId      String?               @unique @db.Uuid
  title              String
  libraryType        NeoTrioLibraryType
  publishedAt        DateTime
  campaignId         String?               @db.Uuid
  dealId             String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  production         NeoTrioProduction     @relation(fields: [productionId], references: [id], onDelete: Cascade)
  marketingContent   MarketingContent?     @relation(fields: [marketingContentId], references: [id], onDelete: SetNull)
  publication        MarketingPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  campaign           MarketingCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deal               MarketingDeal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([libraryType, publishedAt])
  @@index([campaignId])
  @@index([dealId])
}

model MarketingCalendarEntry {
  id                String                     @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  entryType         MarketingCalendarEntryType
  startAt           DateTime
  endAt             DateTime?
  allDay            Boolean                    @default(false)
  status            MarketingCalendarStatus    @default(PLANNED)
  campaignId        String?                    @db.Uuid
  dealId            String?                    @db.Uuid
  contentId         String?                    @db.Uuid
  publicationId     String?                    @db.Uuid
  assignedUserId    String?                    @db.Uuid
  channel           MarketingChannel?
  source            MarketingCalendarSource    @default(INTERNAL)
  externalReference String?
  createdById       String                     @db.Uuid
  updatedById       String                     @db.Uuid
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  campaign          MarketingCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deal              MarketingDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  content           MarketingContent?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  publication       MarketingPublication?      @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  assignedUser      User?                      @relation("MarketingCalendarAssignedTo", fields: [assignedUserId], references: [id], onDelete: SetNull)
  createdBy         User                       @relation("MarketingCalendarCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User                       @relation("MarketingCalendarUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([startAt, endAt])
  @@index([entryType, status])
  @@index([campaignId])
  @@index([dealId])
  @@index([contentId])
  @@index([assignedUserId])
}

model ExternalMarketingEvent {
  id                String                     @id @default(uuid()) @db.Uuid
  provider          IntegrationProviderType
  externalReference String
  externalType      MarketingCalendarEntryType
  title             String
  scheduledAt       DateTime?
  publishedAt       DateTime?
  status            MarketingCalendarStatus
  channel           MarketingChannel?
  campaignId        String?                    @db.Uuid
  contentId         String?                    @db.Uuid
  rawMetadataSafe   Json?
  lastSyncedAt      DateTime
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  campaign          MarketingCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  content           MarketingContent?          @relation(fields: [contentId], references: [id], onDelete: SetNull)
  dealId            String?                    @db.Uuid
  deal              MarketingDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@unique([provider, externalReference])
  @@index([scheduledAt, publishedAt])
  @@index([channel, status])
}

model IntegrationProvider {
  id               String                  @id @default(uuid()) @db.Uuid
  type             IntegrationProviderType
  name             String
  status           IntegrationStatus       @default(NOT_CONFIGURED)
  lastCheckedAt    DateTime?
  lastSuccessAt    DateTime?
  lastErrorAt      DateTime?
  lastErrorMessage String?
  isEnabled        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  events           IntegrationEvent[]

  @@unique([type, name])
  @@index([status, isEnabled])
}

model IntegrationEvent {
  id                 String                    @id @default(uuid()) @db.Uuid
  providerId         String                    @db.Uuid
  direction          IntegrationEventDirection
  eventType          String
  externalReference  String?
  internalEntityType String?
  internalEntityId   String?
  status             IntegrationEventStatus    @default(PENDING)
  errorMessage       String?
  createdAt          DateTime                  @default(now())
  provider           IntegrationProvider       @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@unique([providerId, eventType, externalReference])
  @@index([providerId, status, createdAt])
  @@index([internalEntityType, internalEntityId])
}

model CallLog {
  id             String        @id @default(uuid()) @db.Uuid
  leadId         String?       @db.Uuid
  customerId     String?       @db.Uuid
  userId         String        @db.Uuid
  direction      CallDirection
  phoneNumber    String
  externalCallId String?
  startedAt      DateTime
  answeredAt     DateTime?
  endedAt        DateTime?
  status         CallStatus
  createdAt      DateTime      @default(now())
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([customerId, createdAt])
  @@index([userId, createdAt])
  @@index([externalCallId])
}

model FollowUp {
  id                       String         @id @default(uuid()) @db.Uuid
  leadId                   String         @db.Uuid
  assignedUserId           String         @db.Uuid
  type                     FollowUpType
  scheduledAt              DateTime
  note                     String
  status                   FollowUpStatus @default(SCHEDULED)
  completedAt              DateTime?
  completedById            String?        @db.Uuid
  createdById              String         @db.Uuid
  dueNotificationSentAt    DateTime?
  missedNotificationSentAt DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  lead                     Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser             User           @relation("FollowUpAssignedUser", fields: [assignedUserId], references: [id], onDelete: Restrict)
  completedBy              User?          @relation("FollowUpCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy                User           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([leadId, status, scheduledAt])
  @@index([assignedUserId, status, scheduledAt])
  @@index([status, scheduledAt])
}

model LeadActivity {
  id          String           @id @default(uuid()) @db.Uuid
  leadId      String           @db.Uuid
  userId      String           @db.Uuid
  type        LeadActivityType
  description String
  metadata    Json?
  createdAt   DateTime         @default(now())
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([userId])
  @@index([type])
}
